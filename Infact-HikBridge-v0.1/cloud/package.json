{
  "name": "infact-pulse-cloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "build": "npm --workspace functions run build",
    "typecheck": "npm --workspace functions run typecheck",
    "lint": "npm --workspace functions run lint",
    "test": "npm --workspace functions run test",
    "test:rules:unit": "vitest run test/firestore.rules.test.ts",
    "test:emulator:unit": "npm run test:rules:unit && npm --workspace functions run test:emulator",
    "test:rules": "firebase emulators:exec --project demo-hikbridge --only firestore,database \"npm run test:emulator:unit\"",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "set:platform-admin": "node scripts/set-platform-admin.mjs",
    "set:function-public": "node scripts/set-run-public-invoker.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "20.19.43",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
